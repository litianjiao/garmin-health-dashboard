# Garmin 数据来源：官方 Personal API（推荐）或第三方 MCP（备用）
# 官方 key：Garmin Connect 网页 → 设置 → Personal API Key 生成，填到下面
GARMIN_API_KEY=
# 备用通道：设 GARMIN_TRANSPORT=mcp 并配置账号密码（不支持 2FA 账号）
GARMIN_TRANSPORT=
GARMIN_USERNAME=
GARMIN_PASSWORD=

# 本地服务
HOST=127.0.0.1
PORT=8787
DISPLAY_NAME=ZAX
ACTUAL_AGE=28

# 远程访问时务必修改；本地空白会跳过登录
DASHBOARD_PASSWORD=
SESSION_SECRET=
# 使用 HTTPS 隧道或部署到公网时设为 true
SECURE_COOKIES=false
